{
  "name": "@get-keel/core",
  "version": "0.1.9",
  "description": "Core enforcement engine for Keel — policy engine, signed receipts, and the tool-call enforce pipeline for AI coding agents.",
  "keywords": [
    "ai-agents",
    "ai-safety",
    "agent-security",
    "guardrails",
    "policy-engine",
    "enforcement",
    "llm",
    "coding-agent",
    "governance"
  ],
  "homepage": "https://github.com/qiweiz94/keel#readme",
  "bugs": {
    "url": "https://github.com/qiweiz94/keel/issues"
  },
  "author": "Chaoyi Li",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && npx esbuild src/keel-core.ts --bundle --format=esm --outfile=dist/keel-core.mjs --external:yaml --packages=external",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiweiz94/keel.git"
  }
}
