{
  "name": "@get-keel/core",
  "version": "0.1.5",
  "description": "Core enforcement engine for Keel — policy engine, signing, receipts, enforce pipeline",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && npx esbuild src/keel-core.ts --bundle --format=esm --outfile=dist/keel-core.mjs --external:yaml --packages=external",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/qiweiz94/keel.git"
  }
}
