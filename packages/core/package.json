{
  "name": "@keel/core",
  "version": "0.1.2",
  "description": "Core enforcement engine for Keel — policy engine, signing, receipts, enforce pipeline",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && npx esbuild src/keel-core.ts --bundle --format=esm --outfile=dist/keel-core.mjs --external:yaml --packages=external",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/qiweiz94/keel.git"
  }
}
