{
  "name": "@get-keel/cli",
  "version": "0.2.0",
  "description": "Enforce rules on AI agents. Rules survive context rot, compaction, and agent amnesia.",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "bin": {
    "keel": "bin/keel.js"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"const f=require('node:fs');f.rmSync('dist',{recursive:true,force:true});f.rmSync('src/core',{recursive:true,force:true});f.cpSync('../core/src','./src/core',{recursive:true})\" && tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "postinstall": "node -e \"if (require('node:fs').existsSync('./dist/postinstall.js')) import('./dist/postinstall.js')\""
  },
  "dependencies": {
    "@get-keel/core": "^0.1.8",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.10",
    "@types/node": "^22.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiweiz94/keel.git"
  }
}
