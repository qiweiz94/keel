{
  "name": "@get-keel/cli",
  "version": "0.2.2",
  "description": "Enforce rules on AI coding agents — guardrails that run outside the context window, so they survive context rot, compaction, and agent amnesia.",
  "keywords": [
    "ai-agents",
    "ai-safety",
    "agent-security",
    "guardrails",
    "policy-engine",
    "pretooluse",
    "hooks",
    "claude-code",
    "opencode",
    "cursor",
    "cline",
    "codex",
    "gemini-cli",
    "mcp",
    "llm",
    "coding-agent",
    "governance"
  ],
  "homepage": "https://github.com/qiweiz94/keel#readme",
  "bugs": {
    "url": "https://github.com/qiweiz94/keel/issues"
  },
  "author": "Chaoyi Li",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "bin": {
    "keel": "bin/keel.js"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"const f=require('node:fs');f.rmSync('dist',{recursive:true,force:true});f.rmSync('src/core',{recursive:true,force:true});f.cpSync('../core/src','./src/core',{recursive:true})\" && tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "postinstall": "node -e \"if (require('node:fs').existsSync('./dist/postinstall.js')) import('./dist/postinstall.js')\""
  },
  "dependencies": {
    "@get-keel/core": "^0.1.9",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@types/node": "^22.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiweiz94/keel.git"
  }
}
