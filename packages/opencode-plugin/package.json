{
  "name": "@get-keel/opencode-plugin",
  "version": "0.1.4",
  "description": "Keel enforcement plugin for OpenCode — rules that survive context rot",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"const f=require('node:fs');f.rmSync('dist',{recursive:true,force:true});f.mkdirSync('dist',{recursive:true})\" && npx esbuild src/plugin.ts --bundle --format=esm --platform=node --external:node:* --alias:yaml=../../node_modules/yaml/browser/index.js --outfile=dist/index.js && node -e \"const f=require('node:fs');f.copyFileSync('dist/index.js','../../packages/cli/templates/keel-enforce.js');f.copyFileSync('src/index.d.ts','dist/index.d.ts')\"",
    "test": "node ./scripts/load-test.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run build"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/qiweiz94/keel.git"
  }
}
